# Maintainer: vyeos <rudranpatel0980@gmail.com>
pkgname=helm-settings
pkgver=@VERSION@
pkgrel=1
pkgdesc='Safe settings control plane for Hyprland desktops'
arch=('x86_64')
url='https://github.com/vyeos/helm-settings'
license=('MPL-2.0')
depends=('bubblewrap' 'gtk4' 'hyprland>=0.56.2' 'libadwaita' 'sqlite')
makedepends=('cargo')
optdepends=('alacritty: terminal integration' 'hyprpaper: wallpaper integration' 'quickshell: shell integration' 'waybar: status bar integration' 'yazi: file manager integration')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR=target cargo build --frozen --release --bin helm-settings
}

check() {
  cd "$pkgname-$pkgver"
  CARGO_TARGET_DIR=target cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/helm-settings "$pkgdir/usr/bin/helm-settings"
  install -Dm644 data/io.github.vyeos.HelmSettings.desktop "$pkgdir/usr/share/applications/io.github.vyeos.HelmSettings.desktop"
  install -Dm644 data/io.github.vyeos.HelmSettings.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.vyeos.HelmSettings.metainfo.xml"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.vyeos.HelmSettings.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.vyeos.HelmSettings.svg"
  install -Dm644 LICENSES/MPL-2.0.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
